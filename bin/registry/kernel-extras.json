{
  "@schema": "kxc.kernel-extras.v1",
  "@description": "Extra KXC registry overlays: caps hints, backend preference, and smca annotations.",
  "extras": {
    "binary_split": {
      "smcaAnnotation": "@kernel binary_split",
      "threadsHint": [32, 1, 1],
      "fallback": "cpu"
    },
    "tensor_attention_fused": {
      "smcaAnnotation": "@kernel tensor_attention_fused",
      "threadsHint": [64, 1, 1],
      "fallback": "cpu"
    },
    "neural_layer_dense": {
      "smcaAnnotation": "@kernel neural_layer_dense",
      "threadsHint": [32, 16, 1],
      "fallback": "cpu"
    },
    "optical_wave_sim": {
      "smcaAnnotation": "@kernel optical_wave_sim",
      "threadsHint": [64, 1, 1],
      "fallback": "cpu"
    },
    "gemm_matmul": {
      "smcaAnnotation": "@kernel gemm_matmul",
      "threadsHint": [64, 1, 1],
      "fallback": "cpu"
    },
    "micronaut_residual_gate": {
      "smcaAnnotation": "@kernel micronaut_residual_gate",
      "threadsHint": [32, 1, 1],
      "fallback": "webgl2"
    },
    "fused_attention": {
      "smcaAnnotation": "@kernel fused_attention",
      "threadsHint": [64, 1, 1],
      "fallback": "cpu",
      "caps": ["needsMatMul", "needsSoftmax", "needsCausalMask", "needsRoPE", "needsGQA", "needsSoftcap"]
    },
    "forward_pass": {
      "smcaAnnotation": "@kernel forward_pass",
      "threadsHint": [64, 1, 1],
      "fallback": "cpu"
    },
    "backward_pass": {
      "smcaAnnotation": "@kernel backward_pass",
      "threadsHint": [32, 1, 1],
      "fallback": "cpu"
    },
    "adam_optimizer": {
      "smcaAnnotation": "@kernel adam_optimizer",
      "threadsHint": [32, 1, 1],
      "fallback": "cpu"
    },
    "gradient_accum": {
      "smcaAnnotation": "@kernel gradient_accum",
      "threadsHint": [32, 1, 1],
      "fallback": "cpu"
    },
    "fold_clamp": {
      "smcaAnnotation": "@kernel fold_clamp",
      "threadsHint": [64, 1, 1],
      "fallback": "cpu"
    }
  }
}
