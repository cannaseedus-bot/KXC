// Generated by kxc for kernel FusedAttention
// variant=shared
cbuffer Params : register(b0)
{
    uint seq_len;
    uint model_dim;
    uint head_dim;
    float scale;
    uint num_experts;
    uint phase_words;
};

StructuredBuffer<float> Q : register(t0);
ByteAddressBuffer KCache : register(t1);
ByteAddressBuffer VCache : register(t2);
StructuredBuffer<float> KScale : register(t3);
StructuredBuffer<float> VScale : register(t4);
RWStructuredBuffer<float> Out : register(u0);

float unpack_int4(uint packed, bool high)
{
    int v = high ? ((packed >> 4) & 0xF) : (packed & 0xF);
    if (v >= 8) v -= 16;
    return (float)v;
}

[numthreads(64, 1, 1)]
void CSMain(uint3 tid : SV_DispatchThreadID)
{
    uint i = tid.x;
    if (i >= seq_len) return;
    uint packedOffset = (i * head_dim) / 2;
    uint wordAddr = packedOffset & ~3;
    uint shift = (packedOffset & 3) * 8;
    uint kp = (KCache.Load(wordAddr) >> shift) & 0xFF;
    uint vp = (VCache.Load(wordAddr) >> shift) & 0xFF;
    float k0 = unpack_int4(kp, false) * KScale[i];
    float v0 = unpack_int4(vp, false) * VScale[i];
    Out[i * head_dim] = (Q[i * head_dim] * k0) * scale + v0;
}
