{
  "tasks": [
    {
      "id": "micronaut_xquery",
      "action": "micronaut_select",
      "description": "Route prompt to grounded micronaut system context via kuhul-server",
      "provider": "kuhul-server",
      "depends_on": []
    },
    {
      "id": "teacher_sample",
      "action": "hive_teacher_complete",
      "description": "Get teacher completion: supernaut:5774 → hive specialist → kuhul_engine:17480 (local) → cloud Ollama",
      "provider": "mn-supernaut",
      "depends_on": ["micronaut_xquery"]
    },
    {
      "id": "distil_step",
      "action": "lora_step",
      "description": "LoRA gradient step on (prompt, teacher_completion) pair",
      "provider": "python-distil",
      "depends_on": ["teacher_sample"]
    },
    {
      "id": "factory_store",
      "action": "store_qa",
      "description": "Write Q&A pair to semantic micronaut for confidence building",
      "provider": "micronaut-factory",
      "depends_on": ["distil_step"]
    }
  ],
  "providers": [
